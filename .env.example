# Copier ce fichier en .env et renseigner les valeurs (ne jamais committer .env).

# Supabase : Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optionnel : sauvegarde dans Google Drive (OAuth Client ID de type « Application Web »)
VITE_GOOGLE_CLIENT_ID=

# Optionnel : bouton « Continuer avec Google » (activer d'abord le fournisseur Google dans Supabase > Auth)
VITE_ENABLE_GOOGLE_LOGIN=false
